{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OuveAI",
  "version": "0.9.3",
  "identifier": "br.com.ouveai",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "publisher": "OuveAI",
    "shortDescription": "Transcrição local de reuniões",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["PortugueseBR"],
        "displayLanguageSelector": false,
        "installerHooks": "windows/hooks.nsh",
        "customLanguageFiles": { "PortugueseBR": "windows/PortugueseBR.nsh" }
      }
    }
  }
}
